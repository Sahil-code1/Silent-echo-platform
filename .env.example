# ============================================================================
# SilentEcho environment template.
#   Local:   copy to .env, fill in real values, never commit .env.
#   Windows: load it with   . .\scripts\load-env.ps1      (PowerShell)
#   Railway: enter these same names as service variables instead of a file.
# Every value below is a placeholder.
# ============================================================================

# --- Database (MySQL 8+) ---
SILENTECHO_DB_URL=jdbc:mysql://localhost:3306/silentecho_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SILENTECHO_DB_USERNAME=silentecho_user
SILENTECHO_DB_PASSWORD=CHANGE_ME
# "update" for first-run development. Use "validate" once db/schema.sql has been applied.
SILENTECHO_DDL_AUTO=update

# --- Secrets (generate fresh values for every environment; see scripts/new-secrets.ps1) ---
# Keyed HMAC for sign-in ID digests. At least 32 characters. Changing it invalidates every sign-in ID.
SILENTECHO_HMAC_SECRET=CHANGE_ME
# AES-256 key for stored content. Must decode to exactly 32 bytes. Changing it makes stored content unreadable.
SILENTECHO_ENCRYPTION_KEY=CHANGE_ME

# --- Evidence storage ---
# Local: ./data/evidence. Railway: /app/data/evidence on a mounted volume.
SILENTECHO_EVIDENCE_DIR=./data/evidence

# --- Web, CORS and session cookies ---
# Local development: frontend served at http://localhost:5500.
# Production: the Vercel origin, for example https://silentecho.vercel.app (no trailing slash).
SILENTECHO_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Local (HTTP): false. Production (HTTPS): true. The prod profile refuses to start with false.
SILENTECHO_COOKIE_SECURE=false
# lax: correct for both local development and the production same-origin /api rewrite on Vercel.
SILENTECHO_COOKIE_SAMESITE=lax
PORT=8080

# --- Spring profile (set to prod on Railway; the Dockerfile already sets it) ---
# SPRING_PROFILES_ACTIVE=prod

# --- Optional advisory AI triage (Google Gemini). Leave empty to use the rule-based fallback. ---
GEMINI_API_KEY=
